{
  "name": "reptile-center-sim",
  "version": "1.0.0",
  "description": "Simulateur de capteurs d'un centre de rehabilitation pour reptiles",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:json": "node src/index.js --format json",
    "start:mqtt": "node src/index.js --output mqtt",
    "chaos": "node src/index.js --scenario chaos --output mqtt",
    "server": "node src/server.js",
    "broker": "docker compose up mosquitto",
    "front": "open front/index.html"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "mqtt": "^5.16.0"
  }
}
