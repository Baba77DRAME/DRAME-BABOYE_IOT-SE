# ── Broker ──────────────────────────────────────────────────────────────────
MQTT_BROKER=mqtt://localhost:1883
MQTT_USER=simulator
MQTT_PASS=simulator

# ── Identité du client ───────────────────────────────────────────────────────
# Laisser vide pour générer automatiquement : simulator-main-<hex>
MQTT_CLIENT_ID=

# ── Topics ───────────────────────────────────────────────────────────────────
MQTT_ROOT_TOPIC=reptiles/v1

# ── Session ──────────────────────────────────────────────────────────────────
# true  = session propre à chaque connexion (recommandé avec buffering applicatif)
# false = session persistante côté broker (nécessite un MQTT_CLIENT_ID fixe)
MQTT_CLEAN_SESSION=true
MQTT_KEEPALIVE=60

# ── Reconnexion (backoff exponentiel) ────────────────────────────────────────
# Délai initial en ms, doublé à chaque échec jusqu'à MQTT_RECONNECT_MAX_DELAY
MQTT_RECONNECT_MIN_DELAY=3000
MQTT_RECONNECT_MAX_DELAY=30000

# ── Tampon hors-ligne ────────────────────────────────────────────────────────
# Nombre maximum de messages conservés pendant une coupure réseau.
# 60 % réservés aux messages haute priorité (QoS 1 : porte, boot, ack, availability).
# 40 % pour les messages basse priorité (QoS 0 : telemetry, heartbeat).
MQTT_BUFFER_MAX=500
